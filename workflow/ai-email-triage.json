    {
      "parameters": {
        "jsCode": "const out = [];\nconst items = $input.all();\n\nfor (let i = 0; i < items.length; i++) {\n  const raw = items[i].json.content?.parts?.[0]?.text ?? '';\n  let r = {};\n  try {\n    r = JSON.parse(raw.replace(/```json|```/g, '').trim());\n  } catch (e) {\n    r = { category: 'parse_error', urgency: '', language: '', sender_name: '', summary: raw.slice(0, 200) };\n  }\n\n  let mail;\n  try { mail = $('Get many messages').itemMatching(i).json; }\n  catch (e) { mail = $('Gmail Trigger').itemMatching(i).json; }\n\n  out.push({ json: {\n    received: mail.date,\n    message_id: mail.id,\n    sender_name: r.sender_name,\n    subject: mail.subject,\n    category: r.category,\n    urgency: r.urgency,\n    language: r.language,\n    summary: r.summary,\n  }});\n}\nreturn out;"
      },
